if (n >= 0) {
if (m >= 0) {
let s0, r = channel();
spawn { 
  let s1 = s0.clone();
  spawn {
    let i = 0;
    while (i < n) {
      s0.send(0);
      i += 1;
    }
  }

  spawn {
    let i = 0;
    while (i < m) {
      s1.send(1);
      i += 1;
    }
  }
}

let i = 0;
let count_zero = 0;
let count_one = 0;

//#[invariant(count_zero + count(@r, |x| x == 0) == n)]
//#[invariant(count_one + count(@r, |x| x == 1) == m)]
while (i < n + m) {
  //verify!(count_zero + count(@r, |x| x == 0) == n);
  let x = r.recv();
  if (x == 0) {
    count_zero += 1;
  }
  if (x == 1) {
    count_one += 1;
  }
  i += 1;
}
assert!(count_zero == n);
assert!(count_one == m);
}}
